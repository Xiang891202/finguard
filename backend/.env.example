# ============================================
# 環境
# ============================================
ENV=development
DEBUG=true

# ============================================
# 資料庫
# ============================================
# 本機 Docker（開發）
DATABASE_URL=postgresql://finguard:dev_password_change_me@localhost:5432/finguard

# 雲端（Neon / Supabase，之後切換）
# DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# JWT
# ============================================
JWT_SECRET=change-this-to-a-random-secret
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# ============================================
# 加密（基因資料）
# ============================================
ENCRYPTION_KEY=change-this-to-a-random-key

# ============================================
# Email（SMTP）
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@finguard.local

# ============================================
# LLM Provider
# ============================================
LLM_DEFAULT_PROVIDER=template
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434

# ============================================
# 應用
# ============================================
ADMIN_ALERT_EMAIL=
SIMULATION_COUNT=10000
FORECAST_MODEL_VERSION=v1.0.0
RANDOM_SEED=42